%%{init: {"theme": "dark", "themeVariables": {"background": "#020617", "primaryColor": "#111827", "primaryTextColor": "#e6edf3", "primaryBorderColor": "#818cf8", "lineColor": "#94a3b8", "secondaryColor": "#083344", "tertiaryColor": "#064e3b", "clusterBkg": "#0b1220", "clusterBorder": "#475569", "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif", "fontSize": "18px"}, "flowchart": {"curve": "basis", "nodeSpacing": 70, "rankSpacing": 80, "padding": 24}} }%%
flowchart TD
  iain["Iain"]

  subgraph vm["Juni VM boundary"]
    direction TD
    signal["Signal"]
    traefik["Traefik"]
    webui["Juni WebUI"]
    juni(("Juni VM\nHermes runtime"))
    signal --> juni
    traefik --> juni
    webui --> juni
  end

  subgraph out["Models, tools, and memory"]
    direction TD
    codex["OpenAI Codex"]
    openrouter["OpenRouter"]
    local["Local RTX 5090"]
    github["GitHub"]
    affine["Affine"]
    onepassword["1Password"]
  end

  iain --> signal
  iain --> traefik
  iain --> webui
  juni --> codex
  juni --> openrouter
  juni --> local
  juni --> github
  juni --> affine
  juni -. secrets .-> onepassword

  classDef human fill:#0f172a,stroke:#f472b6,color:#f8fafc,stroke-width:2px
  classDef iface fill:#083344,stroke:#22d3ee,color:#f8fafc,stroke-width:2px
  classDef runtime fill:#111827,stroke:#818cf8,color:#f8fafc,stroke-width:3px
  classDef model fill:#4c1d95,stroke:#a78bfa,color:#f8fafc,stroke-width:2px
  classDef data fill:#064e3b,stroke:#34d399,color:#f8fafc,stroke-width:2px
  classDef secret fill:#881337,stroke:#fb7185,color:#f8fafc,stroke-width:2px

  class iain human
  class signal,traefik,webui iface
  class juni runtime
  class codex,openrouter,local model
  class github,affine data
  class onepassword secret
